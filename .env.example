# Groq API — required for chat
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile
GROQ_CHAT_MODEL=

# Neon Postgres (with pgvector) — required for RAG
NEON_DATABASE_URL=

# Clerk auth — required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional
OPENROUTER_API_KEY=
